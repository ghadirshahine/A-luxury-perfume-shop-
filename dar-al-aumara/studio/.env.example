# Sanity Studio env (copy to .env). Studio reads vars prefixed SANITY_STUDIO_.

# Public origin of the storefront the Presentation tool previews against.
# Local Next.js dev server:  http://localhost:3000
# On Vercel services, use the shared project origin (without /studio).
# Example: https://your-project.vercel.app
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
